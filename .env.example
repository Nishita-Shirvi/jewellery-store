# ─────────────────────────────────────────────────────────────
# Jewellery Store — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
# Local:  postgresql://postgres:postgres@localhost:5432/jewellery_store
# Neon:   DATABASE_URL = the *pooled* connection string (host contains "-pooler")
#         DIRECT_URL   = the *direct* connection string (used by migrations)
# For local development both can be the same.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jewellery_store"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jewellery_store"

# Auth.js
# A long random secret that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different value in production. Never share it.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Only needed when running a production build yourself (npm run build && npm start)
# outside Vercel. Vercel sets this automatically. In that case set AUTH_URL to the
# site address, e.g. AUTH_URL="https://www.yourstore.in", or AUTH_TRUST_HOST="true".
# AUTH_URL=""
# AUTH_TRUST_HOST="true"

# Google sign-in (optional). Leave empty to hide the "Continue with Google" button.
# Create at https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Razorpay (test mode first). Checkout shows "payments not set up" until all three are set.
# Dashboard → switch to Test Mode → Account & Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Account & Settings → Webhooks → Add webhook (after deploying, Phase 8):
#   URL: https://<your-domain>/api/webhooks/razorpay   Events: payment.captured, payment.failed
# Choose any long random secret there and paste the same value here.
RAZORPAY_WEBHOOK_SECRET=""

# Email (Resend). Without a key, emails are only written to the terminal log.
# https://resend.com → API Keys. Until you verify your own domain, Resend only delivers
# to the email address you signed up with.
RESEND_API_KEY=""
EMAIL_FROM="Jewellery Store <onboarding@resend.dev>"

# Product image uploads (Cloudinary, free plan). Without these, admins choose from the
# placeholder illustrations. https://cloudinary.com → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Business details — shown on the legal pages (Privacy, Terms, Refunds, Shipping, Contact).
# Required before going live; have a lawyer/CA check the pages.
BUSINESS_LEGAL_NAME="[Your registered business name]"
BUSINESS_ADDRESS="[Registered address, City, State, PIN]"
BUSINESS_EMAIL="support@example.com"
BUSINESS_PHONE="[+91 phone number]"
BUSINESS_GSTIN="[GSTIN]"
# Your state for GST (same state → CGST+SGST, other states → IGST). Must match the official name, e.g. "Telangana"
BUSINESS_STATE="Telangana"
# Invoice numbers look like INV/2026-27/000001
INVOICE_PREFIX="INV"

# Optional SMS through MSG91 (needs a DLT-approved template). Leave off until ready.
FEATURE_SMS="false"
MSG91_AUTH_KEY=""
MSG91_ORDER_FLOW_ID=""
GRIEVANCE_OFFICER_NAME="[Grievance officer name]"
GRIEVANCE_OFFICER_EMAIL="grievance@example.com"

# Shiprocket (shipping). Settings → API → Add New API User (use a separate email).
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Name and pincode of your pickup address (Settings → Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE=""
# Any long random text; also enter it in Shiprocket → Settings → API → Webhooks
SHIPROCKET_WEBHOOK_TOKEN=""

# Shipping fee: flat fee in rupees, free at or above the threshold
SHIPPING_FEE_RUPEES="99"
FREE_SHIPPING_ABOVE_RUPEES="999"

# Scheduled jobs: any long random text; also set it in Vercel (and GitHub secrets if using cron.yml).
CRON_SECRET=""

# Error tracking (optional). https://sentry.io → create a Next.js project → copy the DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only on Vercel, to upload source maps for readable error reports:
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Public (safe for the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Jewellery Store"

# Seed script (npx prisma db seed) — the first admin account.
# Use a real email you control and a strong password (12+ characters).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-strong-password"
