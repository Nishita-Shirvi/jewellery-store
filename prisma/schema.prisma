// Prisma schema — Jewellery Store
// Money is always an integer in paise. Weights are always integers in milligrams.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // pooled connection (used by the app)
  directUrl  = env("DIRECT_URL") // direct connection (used by migrations)
  // pg_trgm powers typo-tolerant search (Phase 15). Neon and Supabase support it.
  extensions = [pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  /// Cash on delivery (Phase 18): order accepted, stock taken, money collected at the door.
  CONFIRMED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  RETURN_REQUESTED // customer asked to return delivered items
  REFUND_PENDING // refund sent to Razorpay, waiting for confirmation
  REFUNDED // everything paid has been refunded
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FLAT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_ISSUE
  CHANGED_MIND
  OTHER
}

enum RefundStatus {
  PENDING // created here; Razorpay not called yet or still processing
  PROCESSED
  FAILED
}

enum PaymentProvider {
  RAZORPAY
  /// Cash collected by the courier and remitted to the store (recorded by an admin).
  COD
}

/// How the customer chose to pay.
enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  CREATED // Razorpay order created, waiting for the customer
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// Where a parcel is, in our own words (Shiprocket's many statuses are mapped onto these).
enum ShipmentStatus {
  CREATED // order created at Shiprocket, no courier yet
  AWB_ASSIGNED // courier + tracking number assigned, label ready
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO // returned to origin (refused / undeliverable)
  CANCELLED
}

/// Whether an order is holding stock while the customer pays.
enum ReservationState {
  NONE
  ACTIVE // stock held until reservedUntil
  CONVERTED // paid: the hold became a real stock decrease
  RELEASED // expired, failed or cancelled: the hold was given back
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
}

enum MetalColour {
  YELLOW
  WHITE
  ROSE
  SILVER
}

/// Enum names can't start with a digit, so 22K is stored as K22, sterling silver as S925, etc.
enum Purity {
  K24
  K22
  K18
  K14
  S925
  PT950
}

// ─────────────────────── Users and Auth.js ───────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  /// bcrypt hash. Null for users who only sign in with Google.
  passwordHash       String?
  role               Role      @default(CUSTOMER)
  /// Cash-on-delivery parcels this customer refused (returned to origin). COD is blocked at
  /// [cod] max_refusals in config.ini.
  codRefusals        Int       @default(0)
  /// Personal referral code (Phase 20), created the first time the customer opens it.
  referralCode       String?   @unique
  /// Staff (Phase 21): set when the owner deactivates this person (role goes back to CUSTOMER).
  staffDeactivatedAt DateTime?
  /// Authenticator-app secret, encrypted (lib/secret-box.ts). Null = two-step sign-in not set up.
  totpSecret         String?
  totpEnabledAt      DateTime?
  /// Last accepted 30-second step: a code can't be used twice.
  totpLastStep       Int?
  /// SHA-256 hashes of unused one-time recovery codes.
  recoveryCodes      String[]  @default([])
  /// Account lockout (Phase 23): wrong passwords in a row, and when the lock ends.
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  /// Sessions started before this are signed out (password changed / reset).
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts          Account[]
  wishlist          WishlistItem[]
  reviews           Review[]
  couponRedemptions CouponRedemption[]
  sessions          Session[]
  cart              Cart?
  addresses         Address[]
  orders            Order[]
  otpChallenges     OtpChallenge[]
  referralsMade     Referral[]           @relation("ReferralReferrer")
  referredBy        Referral?            @relation("ReferralReferred")
  cartReminders     CartReminder[]
  staffRoles        UserRole[]
  passwordResets    PasswordResetToken[]
  supportTickets    SupportTicket[]      @relation("TicketCustomer")
  assignedTickets   SupportTicket[]      @relation("TicketAssignee")

  @@index([role])
}

/// One-time code sent by SMS (e.g. to confirm a cash-on-delivery order). Only a hash is stored.
model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  /// 10-digit Indian mobile number the code was sent to.
  phone      String
  /// e.g. "cod"
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Auth.js adapter model (OAuth accounts such as Google).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js adapter model (database sessions).
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js adapter model (email verification / magic links).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ──────────────────────────── Catalog ────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  /// Summary of the variants (Phase 17), kept in sync in the same transaction as every variant change:
  /// lowest active variant price ("from" price), and total stock / held stock of active variants.
  /// Listings, filters, sorting and reports read these; checkout always uses the variant rows.
  priceInPaise  Int
  stock         Int      @default(0)
  /// Units held by unpaid orders (15-minute holds). Available = stock - reservedStock.
  reservedStock Int      @default(0)
  images        String[]
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  categoryId    String

  // Jewellery details
  metalType             MetalType
  purity                Purity
  metalColour           MetalColour
  /// Whole piece including stones, in milligrams.
  grossWeightMg         Int?
  /// Metal only, in milligrams.
  netWeightMg           Int
  gemstone              String?
  /// BIS hallmark unique ID (6 characters) where applicable.
  huid                  String?
  makingChargeInPaise   Int         @default(0)
  /// GST: HSN code and rate in basis points (300 = 3%). Jewellery is usually HSN 7113 at 3% — confirm with your CA.
  hsnCode               String      @default("7113")
  gstRateBps            Int         @default(300)
  /// Approved reviews only, recalculated in the same transaction as each moderation change.
  reviewCount           Int         @default(0)
  ratingSum             Int         @default(0)
  /// Average × 100 (e.g. 467 = 4.67 stars): whole numbers, no floating point.
  ratingAvgX100         Int         @default(0)
  /// Lower-case words used by search (name, stones, category, metal, purity). Rebuilt on every product/category save.
  searchText            String      @default("")
  isReturnable          Boolean     @default(true)
  /// "Was" price of the variant shown as the "from" price (Phase 24), kept in sync like priceInPaise.
  /// Null = not on sale. The badge's % off is worked out on the server from these two numbers.
  compareAtPriceInPaise Int?
  /// Lower-case labels for rule-based collections, e.g. "bridal", "daily-wear", "festive", "gift".
  tags                  String[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  options       ProductOption[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  orderItems    OrderItem[]
  collections   CollectionProduct[]
  boughtWith    ProductPair[]       @relation("pairProduct")
  boughtWithOf  ProductPair[]       @relation("pairRelated")
  trend         ProductTrend?

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, createdAt])
  @@index([isActive, priceInPaise])
  @@index([isActive, ratingAvgX100])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
}

// ─────────────────────── Product variants (Phase 17) ───────────────────────

/// e.g. "Ring size" or "Metal colour" on one product.
model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

/// e.g. "12" for Ring size, "Rose" for Metal colour.
model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String
  position Int    @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
}

/// One buyable version of a product (size × colour …). Every product has at least one.
/// Products without options have a single "base" variant whose optionKey is "".
model ProductVariant {
  id                    String       @id @default(cuid())
  productId             String
  /// Stock-keeping unit: upper-case letters, digits and dashes, unique across the store.
  sku                   String       @unique
  /// Sorted option value ids joined with "." ("" for the base variant). Unique per product,
  /// so the same combination can never exist twice.
  optionKey             String       @default("")
  /// Shown to customers, e.g. "Ring size 12 / Rose". Empty for the base variant.
  label                 String       @default("")
  priceInPaise          Int
  /// "Was" price for a sale badge (Phase 24). Must be above priceInPaise, or null.
  compareAtPriceInPaise Int?
  stock                 Int          @default(0)
  /// Units held by unpaid orders. Available = stock - reservedStock.
  reservedStock         Int          @default(0)
  /// Variant photos; empty = use the product's photos.
  images                String[]
  isActive              Boolean      @default(true)
  position              Int          @default(0)
  /// Weight differs per size, so it lives on the variant (milligrams).
  netWeightMg           Int
  grossWeightMg         Int?
  /// Overrides the product's colour / purity when the option changes them (null = same as product).
  metalColour           MetalColour?
  purity                Purity?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  stockAlerts  StockAlert[]

  @@unique([productId, optionKey])
  @@index([productId, isActive])
}

model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// ───────────────────────────── Cart ──────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([productId])
  @@index([variantId])
}

// ─────────────────────────── Addresses ───────────────────────────

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────── Orders ─────────────────────────────

model Order {
  id                 String           @id @default(cuid())
  userId             String
  /// Phase 25: which recommendation widget led to each product, e.g. {"<productId>": "similar"}.
  /// Copied from the shopper's cookie when the order is created; purchase stats read it.
  recoAttribution    Json?
  status             OrderStatus      @default(PENDING)
  subtotalInPaise    Int
  shippingInPaise    Int              @default(0)
  totalInPaise       Int
  /// Copy of the delivery address at the time of purchase (addresses can change later).
  addressSnapshot    Json
  paidAt             DateTime?
  /// One per "Pay" click session: a second click with the same key returns the same order.
  checkoutKey        String?          @unique
  /// Why the order was cancelled (e.g. sold out after payment, refund needed).
  cancellationReason String?
  reservationState   ReservationState @default(NONE)
  /// When the stock hold ends if the order isn't paid.
  reservedUntil      DateTime?
  /// Set when an unpaid order is closed because its hold expired.
  expiredAt          DateTime?
  deliveredAt        DateTime?
  /// Sum of PROCESSED refunds, in paise.
  refundedInPaise    Int              @default(0)
  couponId           String?
  couponCode         String?
  /// Coupon discount on the items (never on shipping), in paise.
  discountInPaise    Int              @default(0)
  paymentMethod      PaymentMethod    @default(ONLINE)
  /// Cash-on-delivery handling fee ([cod] fee_rupees), included in totalInPaise.
  codFeeInPaise      Int              @default(0)
  /// When a COD parcel came back to the store (refused / undeliverable).
  rtoAt              DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  payments         Payment[]
  shipment         Shipment?
  returns          ReturnRequest[]
  invoice          Invoice?
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?
  refunds          Refund[]
  supportTickets   SupportTicket[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([reservationState, reservedUntil])
  @@index([createdAt])
  @@index([paymentMethod, status])
}

model OrderItem {
  id                  String @id @default(cuid())
  orderId             String
  productId           String
  /// The exact variant bought (orders from before Phase 17 point at the product's base variant).
  variantId           String
  /// SKU and variant label at purchase time ("" label = product without options).
  sku                 String @default("")
  variantLabel        String @default("")
  /// Snapshots taken at purchase time so the order never changes when the product does.
  productName         String
  productSlug         String
  priceInPaise        Int
  quantity            Int
  lineTotalInPaise    Int
  /// Metal, purity, colour, weights, gemstone, HUID at purchase time.
  productSnapshot     Json
  /// Units already returned/refunded (a piece can't be refunded twice).
  returnedQuantity    Int    @default(0)
  /// Tax snapshot at purchase time (prices include GST). IGST for other states, CGST+SGST within the seller's state.
  hsnCode             String @default("7113")
  gstRateBps          Int    @default(300)
  taxableValueInPaise Int    @default(0)
  cgstInPaise         Int    @default(0)
  sgstInPaise         Int    @default(0)
  igstInPaise         Int    @default(0)
  /// This line's share of the order's coupon discount (GST is worked out on the price after discount).
  discountInPaise     Int    @default(0)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String          @unique
  /// Unique so the same payment can never be processed twice (idempotency).
  providerPaymentId String?         @unique
  status            PaymentStatus   @default(CREATED)
  amountInPaise     Int
  currency          String          @default("INR")
  method            String?
  failureReason     String?
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
}

// ─────────────────────── Coupons and wishlist ─────────────────────

model Coupon {
  id                 String     @id @default(cuid())
  /// Stored in UPPER CASE; customers can type it in any case.
  code               String     @unique
  type               CouponType
  /// PERCENT: whole percent (1–90). FLAT: paise.
  value              Int
  minOrderInPaise    Int        @default(0)
  maxDiscountInPaise Int?
  startsAt           DateTime?
  endsAt             DateTime?
  /// Total uses allowed (null = unlimited).
  usageLimit         Int?
  /// Uses per customer (null = unlimited).
  perUserLimit       Int?       @default(1)
  /// Paid orders that used this coupon (updated inside the payment transaction).
  usedCount          Int        @default(0)
  /// Only this customer may use it (personal reward / reminder coupons, Phase 20).
  assignedUserId     String?
  /// e.g. "abandoned_cart", "referral" — for campaign stats. Null = made by an admin.
  campaign           String?
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive])
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  userId          String
  orderId         String   @unique
  discountInPaise Int
  createdAt       DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

// ──────────────────────────── Reviews ────────────────────────────

/// One review per customer per product, only from customers whose order with it was delivered.
model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String
  body       String
  images     String[]
  status     ReviewStatus @default(PENDING)
  adminNote  String?
  /// Name shown publicly, e.g. "Priya S." (first name + initial).
  authorName String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

// ─────────────────────────── Invoices ────────────────────────────

/// Tax invoice. The snapshot is frozen at creation so the PDF never changes later.
model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  /// e.g. INV/2026-27/000123 — sequential per financial year, no gaps.
  number        String   @unique
  financialYear String
  sequence      Int
  snapshot      Json
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([financialYear, sequence])
}

/// Last invoice number used in each financial year (row-locked while numbering).
model InvoiceCounter {
  financialYear String @id
  lastNumber    Int    @default(0)
}

// ─────────────────────── Returns and refunds ──────────────────────

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  userId    String
  status    ReturnStatus @default(REQUESTED)
  reason    ReturnReason
  details   String?
  photoUrl  String?
  /// Put the items back in stock when approved.
  restock   Boolean      @default(true)
  adminNote String?
  decidedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  returnRequestId  String?
  paymentId        String
  /// Set once Razorpay accepts the refund. Unique so a refund is never recorded twice.
  razorpayRefundId String?      @unique
  amountInPaise    Int
  status           RefundStatus @default(PENDING)
  reason           String
  failureReason    String?
  rawPayload       Json?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}

// ──────────────────────────── Shipping ───────────────────────────

/// One parcel per order, created through Shiprocket.
model Shipment {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  provider           String         @default("SHIPROCKET")
  providerOrderId    String?
  providerShipmentId String?
  awb                String?        @unique
  courier            String?
  trackingUrl        String?
  labelUrl           String?
  status             ShipmentStatus @default(CREATED)
  /// Last error while creating the shipment (shown to the admin; cleared on success).
  lastError          String?
  rawPayload         Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events ShipmentEvent[]

  @@index([status])
}

/// Tracking timeline. The unique key makes repeated webhooks harmless.
model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  label      String
  location   String?
  occurredAt DateTime
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, label, occurredAt])
  @@index([shipmentId, occurredAt])
}

// ─────────────────────── Audit and analytics ─────────────────────

/// Who changed what in the admin panel. Never edited or deleted by the app.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  /// e.g. product.update, order.status, coupon.create, refund.retry
  action     String
  entityType String
  entityId   String
  summary    String
  /// Before/after values for the fields that changed, when known.
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

/// Anonymous daily counters for the sales funnel (no personal data, so no consent needed).
model FunnelDaily {
  /// India-time date, e.g. 2026-10-11
  day   String
  /// view_item | add_to_cart | begin_checkout | purchase
  event String
  count Int    @default(0)

  @@id([day, event])
}

// ───────────────────── Marketing (Phase 20) ──────────────────────

enum SubscriberStatus {
  PENDING // signed up, confirmation email sent (double opt-in)
  SUBSCRIBED // clicked the confirmation link
  UNSUBSCRIBED // asked to stop — also blocks cart reminders and any other marketing email
}

/// One row per email address: newsletter consent and the marketing "do not email" list.
model Subscriber {
  id             String           @id @default(cuid())
  /// Lower case.
  email          String           @unique
  status         SubscriberStatus @default(PENDING)
  /// Hash of the confirmation token (the token itself is only in the email).
  confirmHash    String?
  /// When and how consent was given, and the wording shown (proof of consent).
  consentAt      DateTime?
  consentSource  String?
  consentText    String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

/// One reminder email about a cart left behind. `cartVersion` is the time of the last cart change,
/// so a cart that changes again gets a fresh pair of reminders, and each step is sent once.
model CartReminder {
  id          String    @id @default(cuid())
  userId      String
  cartVersion DateTime
  /// 1 = after an hour, 2 = after a day
  step        Int
  couponCode  String?
  sentAt      DateTime  @default(now())
  /// The customer ordered within 7 days of this reminder.
  recoveredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cartVersion, step])
  @@index([sentAt])
}

/// "Email me when this is back in stock" for one variant.
model StockAlert {
  id         String    @id @default(cuid())
  /// Lower case.
  email      String
  userId     String?
  productId  String
  variantId  String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([email, variantId])
  @@index([notifiedAt, variantId])
}

enum ReferralStatus {
  PENDING // friend signed up, no delivered order yet
  REWARDED // friend's first order was delivered; referrer got a coupon
  VOID // looked like a self-referral
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  /// A customer can only ever be referred once.
  referredUserId String         @unique
  status         ReferralStatus @default(PENDING)
  rewardCode     String?
  voidReason     String?
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
}

// ───────────────────── Staff roles (Phase 21) ──────────────────────

/// e.g. "orders.view". Seeded from lib/permissions.ts.
model Permission {
  key         String           @id
  description String
  roles       RolePermission[]
}

/// OWNER, MANAGER, CATALOG_EDITOR, ORDER_MANAGER, SUPPORT (seeded from lib/permissions.ts).
model StaffRole {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
  invites     StaffInvite[]
}

model RolePermission {
  roleId        String
  permissionKey String

  role       StaffRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Owner invites someone by email; they sign in with that email and accept.
model StaffInvite {
  id             String    @id @default(cuid())
  /// Lower case.
  email          String
  roleId         String
  /// SHA-256 of the token in the emailed link.
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([email])
}

// ───────────────────── Customer support (Phase 22) ─────────────────

/// Help-centre question and answer, shown at /help when published.
model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  /// e.g. "Orders", "Returns", "Jewellery care"
  category    String   @default("General")
  position    Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, category, position])
}

enum TicketStatus {
  OPEN // waiting for the store
  ANSWERED // the store replied; waiting for the customer
  RESOLVED // done (the customer can reopen by replying)
}

enum TicketCategory {
  ORDER
  DELIVERY
  RETURN
  PAYMENT
  PRODUCT
  OTHER
}

model SupportTicket {
  id                    String         @id @default(cuid())
  userId                String
  orderId               String?
  subject               String
  category              TicketCategory @default(OTHER)
  status                TicketStatus   @default(OPEN)
  assignedToId          String?
  /// Used for "waiting more than 24 h" and sorting.
  lastCustomerMessageAt DateTime       @default(now())
  lastStaffReplyAt      DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user        User               @relation("TicketCustomer", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo  User?              @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]
  attachments TicketAttachment[]

  @@index([userId, updatedAt])
  @@index([status, lastCustomerMessageAt])
  @@index([assignedToId, status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String?
  fromStaff Boolean  @default(false)
  /// Staff-only note: never shown to the customer.
  internal  Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
}

/// Customer photos / documents. Stored privately in the database (never on a public URL) and
/// served only to the ticket's customer or support staff.
model TicketAttachment {
  id          String   @id @default(cuid())
  ticketId    String
  messageId   String
  filename    String
  /// Detected from the file's bytes, not the browser's claim.
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  ticket  SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

/// Saved answers support staff can insert into a reply.
model CannedReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// "Forgot password" link (Phase 23): one use, 30 minutes, only a hash stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────── Background jobs (Phase 19) ──────────────────

enum JobStatus {
  PENDING // waiting for runAt
  RUNNING // claimed by a worker (lockedAt)
  DONE
  DEAD // failed maxAttempts times — shown in Admin → Jobs with a retry button
}

/// Work done outside the customer's request (emails, invoices, shipments, webhook processing…).
/// Stored in Postgres: no extra service. Claimed with FOR UPDATE SKIP LOCKED, so two workers
/// never run the same job.
model Job {
  id          String    @id @default(cuid())
  /// e.g. "email.order", "invoice.create", "webhook.razorpay"
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(6)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  /// While the job is PENDING/RUNNING no second job with the same key can be queued.
  /// Cleared when the job finishes, so the same work can be queued again later.
  dedupeKey   String?   @unique
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

/// Every verified webhook delivery, saved before any processing. The unique key makes a
/// repeated delivery (providers retry) a no-op.
model WebhookEvent {
  id          String    @id @default(cuid())
  /// "razorpay" | "shiprocket"
  provider    String
  /// Provider's event id, or a hash of the body when the provider sends none.
  eventId     String
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([receivedAt])
}

// ──────────────────────────── Settings ───────────────────────────

/// Key/value store for store-wide settings (shipping rules, feature flags, ...).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────── Merchandising and CMS (Phase 24) ───────────────────────

/// Draft = only staff (and preview links) see it. Published = live within its dates.
enum ContentStatus {
  DRAFT
  PUBLISHED
}

/// MANUAL = hand-picked products in order. RULE = products matching `rules` (see lib/merch.ts).
enum CollectionKind {
  MANUAL
  RULE
}

model Collection {
  id             String         @id @default(cuid())
  /// URL: /collections/<slug>. Can't clash with a category slug (checked on save).
  slug           String         @unique
  title          String
  /// Intro shown above the products (simple markdown).
  description    String         @default("")
  seoTitle       String?
  seoDescription String?
  image          String?
  kind           CollectionKind @default(MANUAL)
  /// RULE collections: { categorySlug?, metalType?, purity?, tags?, minPrice?, maxPrice?, onSale?, newWithinDays? }
  rules          Json           @default("{}")
  status         ContentStatus  @default(DRAFT)
  /// Live from/until (null = no limit). Checked on every request: no deploy or job needed.
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products     CollectionProduct[]
  homeSections HomeSection[]

  @@index([status, startsAt, endsAt])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

enum HomeSectionKind {
  /// Big image with heading, text and a button.
  HERO
  /// A row of products from a collection.
  PRODUCTS
  /// A wide clickable image (e.g. a festival sale).
  BANNER
  /// Heading and text.
  TEXT
}

/// Homepage builder. When no section is live, the built-in homepage shows instead.
model HomeSection {
  id           String          @id @default(cuid())
  kind         HomeSectionKind
  title        String          @default("")
  subtitle     String          @default("")
  body         String          @default("")
  linkUrl      String?
  linkLabel    String?
  imageDesktop String?
  /// Optional narrower image for phones (falls back to imageDesktop).
  imageMobile  String?
  collectionId String?
  position     Int             @default(0)
  status       ContentStatus   @default(DRAFT)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([status, position])
}

/// The thin bar above the header. The live one with the highest priority shows.
model Announcement {
  id        String        @id @default(cuid())
  message   String
  linkUrl   String?
  linkLabel String?
  priority  Int           @default(0)
  status    ContentStatus @default(DRAFT)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, priority])
}

/// Editable pages at /pages/<slug> (About us, Jewellery care…). The legal pages stay in code
/// because they read the business details from config.ini.
model ContentPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  /// What customers see (set when published).
  body           String        @default("")
  /// Work in progress; "Publish" copies it to body.
  draftBody      String        @default("")
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ─────────────────────── Recommendations (Phase 25) ───────────────────────

/// "Frequently bought together": how many paid orders contained both products (last 365 days).
/// Rebuilt as a whole by the nightly job, so running it twice gives the same rows.
model ProductPair {
  productId  String
  relatedId  String
  /// Orders containing both.
  orders     Int
  computedAt DateTime @default(now())

  product Product @relation("pairProduct", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("pairRelated", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId])
  @@index([productId, orders])
}

/// "Trending": units sold in the last 14 days, recent days weighted more. Rebuilt nightly.
model ProductTrend {
  productId  String   @id
  score      Int
  computedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([score])
}

/// Widget clicks / add-to-carts / purchases per day. Several "shard" rows per counter so busy
/// pages never queue behind one row lock; reports add them up.
model RecoStat {
  day    DateTime @db.Date
  widget String
  /// impression | click | add_to_cart | purchase
  event  String
  shard  Int
  count  Int      @default(0)

  @@id([day, widget, event, shard])
}

// ─────────────────────── Monitoring and alerts (Phase 26) ───────────────────────

/// Per-minute counters for things that leave no other trace: payment gateway errors, bad webhook
/// signatures, error log lines. Kept 3 days (pruned by the cron).
model Metric {
  key    String
  /// Start of the minute (UTC).
  minute DateTime
  count  Int      @default(0)

  @@id([key, minute])
  @@index([minute])
}

/// One row per business alert: whether it's firing and when we last told someone.
/// Alerts email once when they start, remind every few hours while firing, and say when resolved.
model AlertState {
  key            String    @id
  firing         Boolean   @default(false)
  since          DateTime?
  lastNotifiedAt DateTime?
  /// What the last check saw (shown in Admin → System).
  detail         String    @default("")
  checkedAt      DateTime  @default(now())
}
